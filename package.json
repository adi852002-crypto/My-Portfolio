{
  "name": "aniruddha-dasgupta-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sitemap.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "lint": "next lint",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.tsx",
    "audit": "node scripts/audit-html.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "verify": "node scripts/verify-browser.mjs",
    "serve": "node -e \"const h=require('node:http'),f=require('node:fs'),p=require('node:path');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let fp=p.join('out',u);if(f.existsSync(fp)&&f.statSync(fp).isDirectory())fp=p.join(fp,'index.html');if(!f.existsSync(fp)){r.statusCode=404;return r.end()}const e=p.extname(fp);r.setHeader('content-type',{'.html':'text/html','.js':'text/javascript','.css':'text/css','.webp':'image/webp','.png':'image/png','.svg':'image/svg+xml','.pdf':'application/pdf','.xml':'application/xml','.txt':'text/plain'}[e]||'application/octet-stream');f.createReadStream(fp).pipe(r)}).listen(8099,()=>console.log('http://127.0.0.1:8099'))\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
